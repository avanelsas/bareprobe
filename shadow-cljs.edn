;; Versions are declared here and again in deps.edn. Keep the two in step. Why each pin is exact
;; is in README.md, under Status.
{:source-paths ["src" "test"]
 :dependencies [[com.github.avanelsas/baredom    "3.8.0"]
                [com.github.avanelsas/barebuild  "0.7.0"]
                [com.github.avanelsas/barereplay "0.4.0"]]

 :builds
 {;; .cjs, not .js: package.json declares "type": "module", which would make Node read the
  ;; CommonJS test bundle as ESM. `core` is pure and DOM-free, so it tests fast without a browser.
  ;; There is no browser target yet. `live` gets one when it does more than wrap a decorator.
  :test
  {:target    :node-test
   :output-to "out/node-tests.cjs"
   :ns-regexp "-test$"}}}
